<Window x:Class="MkMods.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MkMods" Width="1200" Height="750"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Page transition storyboards are managed in code-behind -->
    </Window.Resources>

    <Border CornerRadius="18" ClipToBounds="True">
        <Grid>
            <!-- ═══ Layer 0: Background Image ═══ -->
            <Image x:Name="BgImage" Stretch="UniformToFill" Source="bg_purple.jpg"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- ═══ Layer 1: Dark overlay + blur feel ═══ -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#CC0D0D1A" Offset="0"/>
                        <GradientStop Color="#BB1A1030" Offset="0.5"/>
                        <GradientStop Color="#CC0D0D1A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ═══ Layer 2: Subtle noise/grain texture ═══ -->
            <Border Opacity="0.03">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#FFFFFF">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,1,1"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
            </Border>

            <!-- ═══ Main Content ═══ -->
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>   <!-- Title bar -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                </Grid.RowDefinitions>

                <!-- ════════════════ TITLE BAR ════════════════ -->
                <Border Grid.Row="0" Padding="20,0">
                    <Border.Background>
                        <SolidColorBrush Color="#000000" Opacity="0.25"/>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- App Icon -->
                            <TextBlock Text="◆" Foreground="#A78BFA" FontSize="20" Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="MkMods" Foreground="White" FontSize="17" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="BY SKRENSHO7" Foreground="#6B7280" FontSize="11"
                                       Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>

                        <!-- Language toggle + Window controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- EN / RU Toggle -->
                            <Border CornerRadius="14" Padding="3" Height="30" Width="96"
                                    VerticalAlignment="Center" Cursor="Hand" Margin="0,0,16,0"
                                    MouseLeftButtonDown="LangToggle_Click">
                                <Border.Background>
                                    <SolidColorBrush Color="#FFFFFF" Opacity="0.1"/>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ToggleEN" Grid.Column="0" CornerRadius="11">
                                        <Border.Background>
                                            <SolidColorBrush Color="#7C3AED" Opacity="1"/>
                                        </Border.Background>
                                        <TextBlock Text="EN" Foreground="White" FontSize="12"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ToggleRU" Grid.Column="1" CornerRadius="11"
                                            Background="Transparent">
                                        <TextBlock Text="RU" Foreground="#9CA3AF" FontSize="12"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Button Content="─" Click="BtnMinimize_Click" Width="40" Height="32"
                                    FontSize="14" Foreground="#9CA3AF" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand"/>
                            <Button Content="☐" Click="BtnMaximize_Click" Width="40" Height="32"
                                    FontSize="14" Foreground="#9CA3AF" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand"/>
                            <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click" Width="40" Height="32"
                                    FontSize="13" Foreground="#9CA3AF" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ════════════════ PAGE HOST ════════════════ -->
                <Grid Grid.Row="1">
                    <!-- All pages stacked, visibility-toggled with fade -->

                    <!-- ──── HOME PAGE ──── -->
                    <Grid x:Name="PageHome" Visibility="Visible">
                        <Grid Margin="30,20,30,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="340"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Info Cards -->
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">

                                <!-- Game selector toggle -->
                                <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock x:Name="TxtActiveGame" Text="MY SUMMER CAR"
                                                       Foreground="White" FontSize="26" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtGamePath" Text="Path not found"
                                                       Foreground="#8B8BA0" FontSize="12" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Toggle Switch MSC / MWC -->
                                        <Border Grid.Column="1" CornerRadius="20" Padding="4" Height="40" Width="160"
                                                VerticalAlignment="Center" Cursor="Hand"
                                                MouseLeftButtonDown="GameToggle_Click">
                                            <Border.Background>
                                                <SolidColorBrush Color="#FFFFFF" Opacity="0.1"/>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ToggleMSC" Grid.Column="0" CornerRadius="16"
                                                        Margin="0">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#7C3AED" Opacity="1"/>
                                                    </Border.Background>
                                                    <TextBlock Text="MSC" Foreground="White" FontSize="13"
                                                               FontWeight="Bold" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Border x:Name="ToggleMWC" Grid.Column="1" CornerRadius="16"
                                                        Background="Transparent">
                                                    <TextBlock Text="MWC" Foreground="#9CA3AF" FontSize="13"
                                                               FontWeight="Bold" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- System & License Info -->
                                <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtSystemHeader" Text="SYSTEM" Foreground="#A78BFA" FontSize="11"
                                                       FontWeight="Bold" Margin="0,0,0,10"
                                                       />
                                            <TextBlock x:Name="TxtCPU" Text="CPU: ..." Foreground="#D1D5DB"
                                                       FontSize="12" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="TxtGPU" Text="GPU: ..." Foreground="#D1D5DB"
                                                       FontSize="12" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="TxtRAM" Text="RAM: ..." Foreground="#D1D5DB"
                                                       FontSize="12" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="TxtDisk" Text="Диск: ..." Foreground="#D1D5DB"
                                                       FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="TxtStatusHeader" Text="STATUS" Foreground="#A78BFA" FontSize="11"
                                                       FontWeight="Bold" Margin="0,0,0,10"
                                                       />
                                            <TextBlock x:Name="TxtLicense" Text="⏳ Проверка..."
                                                       Foreground="#FCD34D" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="TxtModLoader" Text="MSCLoader: ..."
                                                       Foreground="#D1D5DB" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="TxtModCount" Text="Модов: ..."
                                                       Foreground="#D1D5DB" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="TxtSavesStatus" Text="Сейвы: ..."
                                                       Foreground="#D1D5DB" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Status bar -->
                                <Border Style="{StaticResource GlassPanel}" Padding="16,12">
                                    <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#9CA3AF"
                                               FontSize="12"/>
                                </Border>

                            </StackPanel>

                            <!-- Right: Action Buttons -->
                            <StackPanel Grid.Column="1">

                                <Button x:Name="BtnPlay" Content="▶  PLAY" Style="{StaticResource PrimaryButton}"
                                        Click="BtnPlay_Click" Margin="0,0,0,10" Height="56" FontSize="18"/>

                                <Button x:Name="BtnInstallMods" Content="📦  Install Mods" Style="{StaticResource GlassButton}"
                                        Click="BtnInstallMods_Click" Margin="0,0,0,8"/>

                                <Button x:Name="BtnSavesBtn" Content="💾  Saves" Style="{StaticResource GlassButton}"
                                        Click="BtnSaves_Click" Margin="0,0,0,8"/>

                                <Button x:Name="BtnModsFolder" Content="📂  Mods Folder" Style="{StaticResource GlassButton}"
                                        Click="BtnOpenModsFolder_Click" Margin="0,0,0,8"/>

                                <Button x:Name="BtnDownloadLoader" Content="⬇  Download MSCLoader" Style="{StaticResource GlassButton}"
                                        Click="BtnDownloadMSCLoader_Click" Margin="0,0,0,8"/>

                                <Button x:Name="BtnDownloadMods" Content="⬇  Download Mods" Style="{StaticResource GlassButton}"
                                        Click="BtnDownloadMods_Click" Margin="0,0,0,8"/>

                                <Button x:Name="BtnSettingsBtn" Content="⚙  Settings" Style="{StaticResource GlassButton}"
                                        Click="BtnSettings_Click" Margin="0,0,0,8"/>

                                <Button x:Name="BtnTelegramBtn" Content="✈  Telegram" Style="{StaticResource GlassButton}"
                                        Click="BtnTelegram_Click" Margin="0,0,0,0"/>

                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ──── MODS PAGE (Install) ──── -->
                    <Grid x:Name="PageMods" Visibility="Collapsed">
                        <Grid Margin="30,20,30,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button x:Name="BtnBackMods" Content="←  Back" Style="{StaticResource GlassButton}"
                                        Click="BtnBack_Click" Margin="0,0,16,0"/>
                                <TextBlock x:Name="TxtModsTitle" Text="INSTALL MODS" Foreground="White" FontSize="22"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Drop zone -->
                            <Border Grid.Row="1" Style="{StaticResource GlassPanel}" AllowDrop="True"
                                    DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                                    Drop="DropZone_Drop" Cursor="Hand"
                                    MouseLeftButtonDown="DropZone_Click">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock x:Name="TxtDropModsTitle" Text="Drag &amp; drop files / folders here" Foreground="White"
                                                   FontSize="16" FontWeight="Medium" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtDropModsSub" Text="or click to browse" Foreground="#8B8BA0"
                                                   FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="TxtDropModsFormats" Text=".dll  .zip  .rar  .7z  folders" Foreground="#6B7280"
                                                   FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>

                                    <!-- File list overlay -->
                                    <ListBox x:Name="ModFileList" Visibility="Collapsed" Margin="0,100,0,0"
                                             Background="Transparent" BorderThickness="0" Foreground="White"
                                             FontSize="13" MaxHeight="280"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Border>

                            <!-- Install button -->
                            <Button x:Name="BtnDoInstallMods" Content="✔  Install Selected"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnDoInstallMods_Click" Margin="0,16,0,0" Height="50"/>
                        </Grid>
                    </Grid>

                    <!-- ──── SAVES PAGE ──── -->
                    <Grid x:Name="PageSaves" Visibility="Collapsed">
                        <Grid Margin="30,20,30,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button x:Name="BtnBackSaves" Content="←  Back" Style="{StaticResource GlassButton}"
                                        Click="BtnBack_Click" Margin="0,0,16,0"/>
                                <TextBlock x:Name="TxtSavesTitle" Text="SAVE GAMES" Foreground="White" FontSize="22"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource GlassPanel}" AllowDrop="True"
                                    DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                                    Drop="DropZoneSaves_Drop" Cursor="Hand"
                                    MouseLeftButtonDown="DropZoneSaves_Click">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="48" HorizontalAlignment="Center"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock x:Name="TxtDropSavesTitle" Text="Drag &amp; drop save files here" Foreground="White"
                                                   FontSize="16" FontWeight="Medium" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtDropSavesSub" Text="or click to browse" Foreground="#8B8BA0"
                                                   FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <ListBox x:Name="SaveFileList" Visibility="Collapsed" Margin="0,100,0,0"
                                             Background="Transparent" BorderThickness="0" Foreground="White"
                                             FontSize="13" MaxHeight="280"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="BtnDoInstallSaves" Content="✔  Install Saves"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="BtnDoInstallSaves_Click" Height="50" Margin="0,0,12,0"/>
                                <Button x:Name="BtnOpenSavesFolder" Content="📂  Open Saves Folder"
                                        Style="{StaticResource GlassButton}"
                                        Click="BtnOpenSavesFolder_Click" Height="50"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ──── SETTINGS PAGE ──── -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <Grid Margin="30,20,30,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button x:Name="BtnBackSettings" Content="←  Back" Style="{StaticResource GlassButton}"
                                        Click="BtnBack_Click" Margin="0,0,16,0"/>
                                <TextBlock x:Name="TxtSettingsTitle" Text="SETTINGS" Foreground="White" FontSize="22"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>

                                    <!-- MSC Mods Path -->
                                    <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtLblMSCMods" Text="MSC — Mods Folder" Foreground="#A78BFA"
                                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtMSCModsPath" FontSize="13"
                                                         Background="#15FFFFFF" Foreground="White"
                                                         BorderBrush="#30FFFFFF" BorderThickness="1"
                                                         Padding="10,8" VerticalContentAlignment="Center"/>
                                                <Button Grid.Column="1" Content="📁" Margin="8,0,0,0"
                                                        Style="{StaticResource GlassButton}" Width="44" Height="38"
                                                        Click="BtnBrowseMSCMods_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- MWC Mods Path -->
                                    <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtLblMWCMods" Text="MWC — Mods Folder" Foreground="#A78BFA"
                                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtMWCModsPath" FontSize="13"
                                                         Background="#15FFFFFF" Foreground="White"
                                                         BorderBrush="#30FFFFFF" BorderThickness="1"
                                                         Padding="10,8" VerticalContentAlignment="Center"/>
                                                <Button Grid.Column="1" Content="📁" Margin="8,0,0,0"
                                                        Style="{StaticResource GlassButton}" Width="44" Height="38"
                                                        Click="BtnBrowseMWCMods_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- MSC Saves Path -->
                                    <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtLblMSCSaves" Text="MSC — Saves Folder" Foreground="#A78BFA"
                                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtMSCSavesPath" FontSize="13"
                                                         Background="#15FFFFFF" Foreground="White"
                                                         BorderBrush="#30FFFFFF" BorderThickness="1"
                                                         Padding="10,8" VerticalContentAlignment="Center"/>
                                                <Button Grid.Column="1" Content="📁" Margin="8,0,0,0"
                                                        Style="{StaticResource GlassButton}" Width="44" Height="38"
                                                        Click="BtnBrowseMSCSaves_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- MWC Saves Path -->
                                    <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtLblMWCSaves" Text="MWC — Saves Folder" Foreground="#A78BFA"
                                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtMWCSavesPath" FontSize="13"
                                                         Background="#15FFFFFF" Foreground="White"
                                                         BorderBrush="#30FFFFFF" BorderThickness="1"
                                                         Padding="10,8" VerticalContentAlignment="Center"/>
                                                <Button Grid.Column="1" Content="📁" Margin="8,0,0,0"
                                                        Style="{StaticResource GlassButton}" Width="44" Height="38"
                                                        Click="BtnBrowseMWCSaves_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Save button -->
                                    <Button x:Name="BtnSaveSettings" Content="💾  Save Settings"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="BtnSaveSettings_Click" Height="48" Margin="0,4,0,0"/>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
